    async function prepareRecoveryProxy(state, record, signal) {
      const runtime=await getProxyRuntime(), secret=await getProxySecret();
      if(runtime.mode!=='proxy') throw new Error('AVITO_IP_BLOCK_PROXY_NOT_ACTIVE');
      let profile=(secret.profiles||[]).find(p=>String(p.id)===String(runtime.selected_profile_id));
      if(!profile) throw new Error('PROXY_PROFILE_CREDENTIALS_UNAVAILABLE');
      await assertCurrentOperation(state);
      // Persist BEFORE changing settings. Startup recovery can always restore the
      // last selected working profile after a worker/browser interruption.
      await storageSet({af_proxy_transaction_v125:{profile_id:profile.id,operation_id:Recovery.operationKey(state),started_at:Date.now()}});
      let result;
      try {
        await applyProxyProfileInternal(profile,'PROXY_RECOVERY_DIAGNOSTIC_APPLIED',{}, {extra_hosts:['api.ipify.org'],pac_nonce:`before-${record.attempt}-${Date.now()}`,preserve_proxy_diagnostics:true});
        const before=await sampleRecoveryEgress(profile,record,signal);
        await assertCurrentOperation(state);
        if(record.attempt>=2 && profile.rotation_settings?.rotate_can_change===true && profile.rotation_settings?.change_ip_link) {
          let latest=await assertCurrentOperation(state);
          const priorRotation=latest.connection_recovery?.provider_rotation || null;
          if(priorRotation?.attempt===record.attempt && ['DISPATCHED_OUTCOME_UNKNOWN','ACKNOWLEDGED'].includes(priorRotation.state)) {
            await log('PROXY_PROVIDER_ROTATION_NOT_REPEATED_AFTER_RESTART',{attempt:record.attempt,profile_id:profile.id,state:priorRotation.state});
          } else {
            const reservation={attempt:record.attempt,state:'DISPATCHED_OUTCOME_UNKNOWN',requested_at:Date.now(),profile_id:profile.id};
            latest=await saveState({...latest,connection_recovery:{...latest.connection_recovery,provider_rotation:reservation}});
            try {
              const request=(url,options)=>Recovery.fetchBounded(globalThis.fetch,url,options,{timeout_ms:8000,signal});
              await ProxyCore.forceChangeIpByLink(request,profile.rotation_settings.change_ip_link);
              latest=await assertCurrentOperation(latest);
              await saveState({...latest,connection_recovery:{...latest.connection_recovery,provider_rotation:{...reservation,state:'ACKNOWLEDGED',acknowledged_at:Date.now()}}});
              await log('PROXY_PROVIDER_ROTATION_ACKNOWLEDGED',{attempt:record.attempt,profile_id:profile.id,ip_change_proven:false});
            } catch(error) {if(signal.aborted) throw error; await log('PROXY_PROVIDER_ROTATION_FAILED',{error:Recovery.redactedError(error),attempt:record.attempt,not_retried_blindly:true});}
          }
        }
        profile=await maybeCreateRecoveryEndpoint(state,(await getState()).connection_recovery,profile,signal);
        await assertCurrentOperation(state);
        // Chrome owns CONNECT pooling. A PAC nonce requests reconfiguration; it
        // does NOT assert that every connection or Avito exit IP was replaced.
        await applyProxyProfileInternal(profile,'PROXY_RECOVERY_RECONFIGURED',{}, {extra_hosts:['api.ipify.org'],pac_nonce:`after-${record.attempt}-${Date.now()}`,preserve_proxy_diagnostics:true});
        const after=await sampleRecoveryEgress(profile,record,signal);
        result={ok:true,strategy:'verified_config_then_fresh_avito_document',profile_id:profile.id,probe_before:before.ip,probe_after:after.ip,probe_ip_changed:Boolean(before.ip&&after.ip&&before.ip!==after.ip),avito_exit_ip_verified:false};
      } finally {
        // No blackhole endpoint and no diagnostic hosts may remain installed.
        // No DIRECT fallback is used for Avito, even after an exception/cancel.
        await applyProxyProfileInternal(profile,'PROXY_RECOVERY_ROUTE_RESTORED',{}, {pac_nonce:`active-${Date.now()}`,preserve_proxy_diagnostics:true});
        await storageRemove('af_proxy_transaction_v125');
      }
      await assertCurrentOperation(state);
      return result;
    }
    
