  actual: |-
    async function maybeCreateRecoveryEndpoint(state, record, profile, signal) {
      const secret=await getProxySecret();
      const apiKey=ProxyCore.text(secret.api_key,512);
      const packageId=ProxyCore.int(profile.package_id || secret.package_id,null);
      if(!apiKey || !packageId || record.attempt < 3) return profile;
      const reserved=await reserveRecoveryEndpoint(state,record);
      if(!reserved) return profile;
      const beforeIds=new Set((secret.profiles||[]).map(p=>String(p.id)));
      const request=(url,options)=>Recovery.fetchBounded(globalThis.fetch,url,options,{timeout_ms:10000,signal});
      try {
        await ProxyCore.createProxyInPackage(request,apiKey,{package_id:packageId,country:profile.country||'ru',rotation:0});
        state=await assertCurrentOperation(state);
        await saveState({...state,connection_recovery:{...state.connection_recovery,create:{...reserved.create,state:'ACKNOWLEDGED'}}});
        // One documented list read. An ambiguous create is never repeated.
        const payload=await ProxyCore.fetchProxyMarketPage(request,apiKey,{package_id:packageId,type:'all',page:1,page_size:50,sort:1});
        const profiles=ProxyCore.normalizeProxyMarketList(payload,{package_id:packageId});
        const candidate=profiles.find(p=>!beforeIds.has(String(p.id)) && p.rotation_settings?.rotate===0 && p.package_id===packageId);
        if(!candidate) throw new Error('PROXY_CREATED_ENDPOINT_RECONCILIATION_REQUIRED');
        state=await assertCurrentOperation(state);
        const all=ProxyCore.dedupeProfileSet([candidate,...(secret.profiles||[])]);
        await savePersistedProxyProfiles(all);
        await saveProxySecret({...secret,profiles:all});
        await saveProxyRuntime({...await getProxyRuntime(),profiles:all.map(ProxyCore.profileSummary)});
        await saveState({...state,connection_recovery:{...state.connection_recovery,create:{...reserved.create,state:'IDENTIFIED',profile_id:candidate.id}}});
        await log('PROXY_RECOVERY_ENDPOINT_IDENTIFIED',{profile_id:candidate.id,attempt:record.attempt,package_id:packageId});
        return candidate;
      } catch(error) {
        if(signal.aborted) throw new Error('OPERATION_CANCELLED');
        await log('PROXY_RECOVERY_CREATE_RECONCILE_REQUIRED',{error:Recovery.redactedError(error),attempt:record.attempt,no_blind_retry:true});
        return profile;
      }
    }
    
