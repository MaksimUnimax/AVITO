        };
        const onRemoved = (removedId) => { if (removedId === tabId) finish(new Error(`SEQUENTIAL_CARD_TAB_MISSING:${tabId}`)); };
        chrome.tabs.onUpdated.addListener(onUpdated);
        chrome.tabs.onRemoved.addListener(onRemoved);
