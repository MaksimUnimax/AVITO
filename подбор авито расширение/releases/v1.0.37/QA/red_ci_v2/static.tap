      const page = result.avito_tab ? (result.avito_tab.ip_block ? "Avito: IP BLOCK" : result.avito_tab.normal_avito ? "Avito: OK" : "Avito: нечитаемо") : "Avito-вкладки нет";
      const err = result.last_proxy_error ? ` · ${result.last_proxy_error}` : "";
