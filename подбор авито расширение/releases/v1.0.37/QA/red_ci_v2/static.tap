      finally { setProxyBusy(false); await refresh(); }
    });
    
    chrome.storage.onChanged.addListener((_changes, area) => { if (area === "local" || area === "session") refresh(); });
    refresh();
    refreshTimer = setInterval(refresh, 1000);
    window.addEventListener("unload", () => { popupDisposed=true; if (refreshTimer) clearInterval(refreshTimer); });
    const createReconciledButton=document.getElementById('proxy-create-reconciled');
    createReconciledButton?.addEventListener('click',async()=>{
      if(!confirm('Проверь endpoint в кабинете Proxy.Market или через «Обновить». Подтвердить ручную сверку и разрешить отдельное новое создание? Это не повтор прежнего запроса.'))return;
      setProxyBusy(true);
      try{const r=await send({type:'AF_PROXY_CREATE_ACKNOWLEDGE',confirmed:true});proxyEndpointStatus.textContent=r?.ok?'Сверка подтверждена. Новый endpoint автоматически не создавался.':proxyFriendlyError(r?.error);}
      finally{setProxyBusy(false);}
    });
    
