{
  "manifest_version": 3,
  "name": "Avito Finder",
  "short_name": "Avito Finder",
  "version": "1.0.24",
  "version_name": "1.0.24-ui-plan-ip-block-recovery",
  "description": "Avito Finder: zero-media Traffic Lite, manual CAPTCHA media reload, verified Proxy.Market egress rotation before Avito IP-block reload, and recoverable pinned ChatGPT context.",
  "minimum_chrome_version": "109",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "debugger",
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://www.avito.ru/*",
    "https://avito.ru/*",
    "https://api.dashboard.proxy.market/*",
    "http://www.avito.ru/*",
    "http://avito.ru/*",
    "https://proxy.market/*",
    "https://*.proxy.market/*",
    "https://api.ipify.org/*",
    "https://api64.ipify.org/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Avito Finder",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "core.js",
        "chatgpt_content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.avito.ru/*",
        "https://avito.ru/*"
      ],
      "js": [
        "core.js",
        "avito_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
